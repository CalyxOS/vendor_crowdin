<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="prompt">داواکاریی پەیوەستبوون</string>
    <string name="warning"><xliff:g id="app">%s</xliff:g> دەیەوێت پەیوەندییەکی VPN ڕێکبخات کە ڕێگەی پێدەدات چاودێری هاتوچۆی تۆڕ بکات. تەنها ئەگەر متمانەت بە سەرچاوەکە هەیە قبووڵی بکە.
        <![CDATA[
        <br />
        <br />
        <img src="vpn_icon" />
        ]]> لە سەرەوەی شاشەکەت دەردەکەوێت کاتێک VPN چالاکە.</string>
    <string name="warning" product="tv"><xliff:g id="app">%s</xliff:g> دەیەوێت پەیوەندییەکی VPN ڕێکبخات کە ڕێگەی پێدەدات چاودێری هاتوچۆی تۆڕ بکات. تەنها ئەگەر متمانەت بە سەرچاوەکە هەیە قبووڵی بکە.
        <![CDATA[
        <br />
        <br />
        <img src="vpn_icon" />
        ]]> لەسەر شاشەکەت دەردەکەوێت کاتێک VPN چالاکە.</string>
    <string name="legacy_title">VPN پەیوەستە</string>
    <string name="session">دانیشتن:</string>
    <string name="duration">ماوە:</string>
    <string name="data_transmitted">نێردراو:</string>
    <string name="data_received">وەرگیراو:</string>
