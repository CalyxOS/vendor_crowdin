<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="app_label">بەڕێوەبەری ئامێری هاوەڵ</string>
    <string name="request_computer_control_access_dialog_title">ڕێگە بە <strong><xliff:g id="agent_app_name" example="Example Agent App">%1$s</xliff:g></strong> بدرێت ئۆتۆماتیککردنی ڕوونما بەکاربهێنێت؟</string>
    <string name="request_computer_control_access_per_app_consent_dialog_title">ڕێگە بە <strong><xliff:g id="agent_app_name" example="Example Agent App">%1$s</xliff:g></strong> بدرێت ئۆتۆماتیککردنی ڕوونما لەگەڵ <strong><xliff:g id="automatable_app_name" example="Example Automatable App">%2$s</xliff:g></strong> بەکاربهێنێت؟</string>
    <string name="request_computer_control_access_dialog_description">ئەم ئەپە دەتوانێت ناوەڕۆکی ڕوونمای ئەپەکانی تر ببینێت و کارلێکیان لەگەڵ بکات بۆ ئەوەی یارمەتیت بدات لە تەواوکردنی کارەکان، تەنانەت کاتێک ئەپەکان لە پاشبنەماشدا بن</string>
    <string name="request_computer_control_access_dialog_button_allow">تەنها ئەمجارە</string>
    <string name="request_computer_control_access_dialog_button_dont_allow">ڕێگە مەدە</string>
    <string name="request_computer_control_access_dialog_button_always_allow">هەمیشە ڕێگە بدە</string>
    <string name="automated_app_launch_warning_dialog_title"><xliff:g id="agent_app_name" example="Example Agent App">%1$s</xliff:g> <xliff:g id="target_app_name" example="Example Target App">%2$s</xliff:g> بەکاردەهێنێت</string>
    <string name="automated_app_launch_warning_dialog_description">بۆ بینینی بەرەوپێشچوونی کارەکە، ئەپی <xliff:g id="agent_app_name" example="Example Agent App">%1$s</xliff:g> بکەرەوە.<xliff:g id="empty_line">\n\n</xliff:g>ئەگەر ئێستا کارەکە ڕابگریت، لەوانەیە بەرەوپێشچوونەکەت لەدەست بدەیت. بۆ دووبارە دەستپێکردنەوە، ئەپی <xliff:g id="agent_app_name" example="Example Agent App">%1$s</xliff:g> بکەرەوە.</string>
    <string name="automated_app_launch_warning_dialog_stop">ڕاگرتنی کار و کردنەوەی ئەپ</string>
    <string name="automated_app_launch_warning_dialog_wait">داخستن</string>
</resources>
