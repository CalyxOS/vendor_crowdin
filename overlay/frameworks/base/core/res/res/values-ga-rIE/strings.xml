    <string name="scIdentifierDisclosureIssueTitle">Aitheantas Gléas rochtaithe</string>
    <string name="scIdentifierDisclosureIssueSummaryNotification">Ag <xliff:g id="disclosure_time">%1$s</xliff:g>, thaifead líonra in aice láimhe aitheantas uathúil do ghléis (IMSI nó IMEI) agus do<xliff:g id="disclosure_network">%2$s</xliff:g> SIM</string>
    <string name="scIdentifierDisclosureIssueSummary">Ag <xliff:g id="disclosure_time">%1$s</xliff:g>, thaifead líonra in aice láimhe aitheantas uathúil do ghléis (IMSI nó IMEI) agus do <xliff:g id="disclosure_network">%2$s</xliff:g> SIM.\n\nCiallaíonn sé seo go bhfuil do shuíomh, do ghníomhaíocht nó d\'aitheantas logáilte. Is cleachtas coitianta é seo ach d’fhéadfadh sé a bheith ina cheist do dhaoine atá buartha faoi phríobháideachas.</string>
    <string name="scNullCipherIssueEncryptedTitle">Ceangailte le líonra criptithe <xliff:g id="network_name">%1$s</xliff:g></string>
    <string name="scNullCipherIssueEncryptedSummary"><xliff:g id="network_name">%1$s</xliff:g> Tá ceangal SIM níos sláine anois</string>
    <string name="scNullCipherIssueNonEncryptedTitle">Ceangailte le líonra gan chriptiú</string>
    <string name="scNullCipherIssueNonEncryptedSummaryNotification">Tá glaonna, teachtaireachtaí agus sonraí níos leochailí faoi láthair agus do <xliff:g id="network_name">%1$s</xliff:g> SIM in úsáid</string>
    <string name="scNullCipherIssueNonEncryptedSummary">Tá glaonna, teachtaireachtaí agus sonraí níos leochailí faoi láthair agus do <xliff:g id="network_name">%1$s</xliff:g> SIM á úsáid agat.\n\nNuair a bheidh do nasc criptithe arís, gheobhaidh tú ceann eile fógra.</string>
