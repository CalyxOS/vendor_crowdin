    <string name="enhanced_confirmation_dialog_title_permission">Diúltaíodh don aip rochtain ar <xliff:g id="permission_name" example="contacts">%1$s</xliff:g></string>
    <string name="enhanced_confirmation_dialog_desc_permission">D\'iarr an aip rochtain ar chead íogair a d\'fhéadfadh d\'fhaisnéis phearsanta agus airgeadais a chur i mbaol.<xliff:g> &lt;br&gt;&lt;br&gt;</xliff:g>D\'fhéadfadh nach n-oibreoidh an aip i gceart gan an srian seo cead. &lt;a href="<xliff:g id="learn_more_link">%1$s</xliff:g>"&gt;Foghlaim conas rochtain a cheadú&lt;/a&gt;</string>
    <string name="enhanced_confirmation_dialog_title_role">Diúltaíodh rochtain don aip mar réamhshocrú <xliff:g id="role_name" example="phone app">%1$s</xliff:g></string>
    <string name="enhanced_confirmation_dialog_desc_role">D\'iarr an aip rochtain ar cheadanna íogaire a d\'fhéadfadh d\'fhaisnéis phearsanta agus airgeadais a chur i mbaol.<xliff:g> &lt;br&gt;&lt;br&gt;</xliff:g>D\'fhéadfadh nach n-oibreoidh an aip i gceart gan na ceadanna srianta seo . &lt;a href="<xliff:g id="learn_more_link">%1$s</xliff:g>"&gt;Foghlaim conas rochtain a cheadú&lt;/a&gt;</string>
    <string name="enhanced_confirmation_dialog_title_settings_default">Diúltaíodh rochtain don aip</string>
    <string name="enhanced_confirmation_dialog_desc_settings_default">Is féidir le rochtain ar an gcead seo do chuid faisnéise pearsanta agus airgeadais a chur i mbaol.<xliff:g>&lt;br&gt;&lt;br&gt;</xliff:g>D\'fhéadfadh nach n-oibreoidh an aip i gceart gan an cead srianta seo. &lt;a href="<xliff:g id="learn_more_link">%1$s</xliff:g>"&gt;Foghlaim conas rochtain a cheadú&lt;/a&gt;</string>
    <string name="permission_grant_dialog_streaming_blocked_title">Iarratas cead faoi chois</string>
    <string name="permission_grant_dialog_streaming_blocked_description">Tá ceadanna breise á lorg ag an aip seo, ach ní féidir ceadanna a dheonú i seisiún sruthaithe. Tabhair an cead ar do ghuthán ar dtús.</string>
