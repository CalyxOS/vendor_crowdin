<resources xmlns:xliff="urn:oasis:names:tc:xliff:document:1.2">
    <string name="feedback_system_logs_title_text">لەخۆگرتنی هەموو لۆگەکانی ئامێر (سیستم و ئەپ)</string>
    <string name="feedback_system_logs_legal_text">هاوبەشکردنی هەموو لۆگەکانی سیستەم و ئەپی ئامێر لەوانەیە وردەکاریی وەک ناوەکانی بەکارهێنەر، شوێن، ناسێنەرەکانی ئامێر، و زانیاریی تۆڕ بۆ Google بنێرێت. Google ئەم زانیارییانە بۆ چارەسەرکردنی کێشە تەکنیکییەکان و باشترکردنی خزمەتگوزارییەکان بەکاردەهێنێت. لە g.co/android/devicelogs زیاتر فێر بە.</string>
    <string name="feedback_bugreport_title_text">لەخۆگرتنی ڕاپۆرتی کێشە</string>
    <string name="feedback_bugreport_legal_display_text">ڕاپۆرتی کێشە (لە %1$s) داتای وەک ناوی بەکارهێنەر، شوێن، ناسێنەری ئامێر، و زانیاریی تۆڕ لەخۆ دەگرێت تا یارمەتیی Google بدات لە تێگەیشتن و چارەسەرکردنی کێشەکە.</string>
    <string name="submit_feedback">ناردن</string>
    <string name="cancel_feedback">پاشگەزبوونەوە</string>
    <string name="feedback_view_system_logs_button_text">بینینی لۆگەکانی سیستم</string>
    <string name="feedback_view_logs_dialog_title">لۆگەکانی سیستم</string>
    <string name="feedback_view_logs_dialog_body">ئەم لۆگانە ئەو زانیارییانە لەخۆ دەگرن کە پێویستمان پێیان دەبێت بۆ ئەوەی بتوانین وەڵامی فیدباکەکەت بدەینەوە.</string>
    <string name="annotated_back_indicator_string">بۆ گەڕانەوە، دوگمەی BACK دابگرە.</string>
