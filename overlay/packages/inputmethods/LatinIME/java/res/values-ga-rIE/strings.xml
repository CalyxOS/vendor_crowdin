    <string name="setup_step1_action">Cumasaigh sna Socruithe</string>
    <string name="setup_step2_title">"Athraigh go <xliff:g id="APPLICATION_NAME" example="Méarchláir Android">%s</xliff:g>"</string>
    <string name="setup_step2_instruction">"Ansin, roghnaigh \"<xliff:g id="APPLICATION_NAME" example="Méarchláir Android">%s</xliff:g>\" mar do mhodh ionchuir téacs gníomhach."</string>
